  "sentences": [
    {
      "idx": 0,
      "speaker": "Max",
      "text": "Ms. Park, I can't find my pencil.",
      "start_ms": 250,
      "end_ms": 4004,
      "ko": "박 선생님, 연필을 못 찾겠어요."
    },
    {
      "idx": 1,
      "speaker": "Ms. Park",
      "text": "Did you look in your desk?",
      "start_ms": 4604,
      "end_ms": 6975,
      "ko": "책상 안은 봤니?"
    },
    {
      "idx": 2,
      "speaker": "Max",
      "text": "Yes, but it isn't there.",
      "start_ms": 7575,
      "end_ms": 9877,
      "ko": "네, 근데 거기 없어요."
    },
    {
      "idx": 3,
      "speaker": "Ms. Park",
      "text": "Check under the table.",
      "start_ms": 10477,
      "end_ms": 12703,
      "ko": "탁자 밑을 봐."
    },
    {
      "idx": 4,
      "speaker": "Max",
      "text": "Oh, here it is!",
      "start_ms": 13303,
      "end_ms": 14790,
      "ko": "아, 여기 있다!"
    },
    {
      "idx": 5,
      "speaker": "Ms. Park",
      "text": "Good.",
      "start_ms": 15390,
      "end_ms": 16465,
      "ko": "좋아."
    },
    {
      "idx": 6,
      "speaker": "Ms. Park",
      "text": "Now write your name at the top.",
      "start_ms": 17065,
      "end_ms": 20122,
      "ko": "이제 맨 위에 이름을 쓰렴."
    },
    {
      "idx": 7,
      "speaker": "Max",
      "text": "Do I write it in big letters?",
      "start_ms": 20722,
      "end_ms": 23338,
      "ko": "이름은 크게 써요?"
    },
    {
      "idx": 8,
      "speaker": "Ms. Park",
      "text": "Yes, nice and big.",
      "start_ms": 23938,
      "end_ms": 26495,
      "ko": "그래, 크고 또박또박하게."
    }
  ]
