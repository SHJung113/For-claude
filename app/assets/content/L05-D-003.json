      "end_ms": 10296,
      "ko": "그리고 내가 어항 청소할게요."
    },
    {
      "idx": 4,
      "speaker": "Mom",
      "text": "Do you promise?",
      "start_ms": 10846,
      "end_ms": 12203,
      "ko": "약속하니?"
