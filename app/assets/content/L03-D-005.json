  "sentences": [
    {
      "idx": 0,
      "speaker": "Doctor",
      "text": "Hello, Max.",
      "start_ms": 250,
      "end_ms": 1643,
      "ko": "안녕, 맥스."
    },
    {
      "idx": 1,
      "speaker": "Doctor",
      "text": "How are you feeling?",
      "start_ms": 2343,
      "end_ms": 3990,
      "ko": "몸은 좀 어떠니?"
    },
    {
      "idx": 2,
      "speaker": "Max",
      "text": "My ear hurts.",
      "start_ms": 4690,
      "end_ms": 5884,
      "ko": "귀가 아파요."
    },
    {
      "idx": 3,
      "speaker": "Doctor",
      "text": "Let me look inside.",
      "start_ms": 6584,
      "end_ms": 8454,
      "ko": "안쪽을 좀 볼게."
    },
    {
      "idx": 4,
      "speaker": "Max",
      "text": "Will it hurt?",
      "start_ms": 9154,
      "end_ms": 10147,
      "ko": "아파요?"
    },
    {
      "idx": 5,
      "speaker": "Doctor",
      "text": "No, it won't hurt.",
      "start_ms": 10847,
      "end_ms": 12589,
      "ko": "아니, 안 아플 거야."
    },
    {
      "idx": 6,
      "speaker": "Doctor",
      "text": "I see.",
      "start_ms": 13289,
      "end_ms": 14278,
      "ko": "그렇구나."
    },
    {
      "idx": 7,
      "speaker": "Doctor",
      "text": "It's a little red.",
      "start_ms": 14978,
      "end_ms": 16535,
      "ko": "조금 빨갛네."
    },
    {
      "idx": 8,
      "speaker": "Mom",
      "text": "Is he okay?",
      "start_ms": 17235,
      "end_ms": 18503,
      "ko": "아이는 괜찮나요?"
    },
    {
      "idx": 9,
      "speaker": "Doctor",
      "text": "He'll be fine in a few days.",
      "start_ms": 19203,
      "end_ms": 21631,
      "ko": "며칠 지나면 괜찮아질 거예요."
    }
