  "sentences": [
    {
      "idx": 0,
      "speaker": "Mom",
      "text": "Are you ready for school?",
      "start_ms": 250,
      "end_ms": 2208,
      "ko": "학교 갈 준비 됐니?"
    },
    {
      "idx": 1,
      "speaker": "Max",
      "text": "I don't want to go.",
      "start_ms": 2808,
      "end_ms": 4691,
      "ko": "가기 싫어요."
    },
    {
      "idx": 2,
      "speaker": "Mom",
      "text": "Why not, honey?",
      "start_ms": 5291,
      "end_ms": 7051,
      "ko": "왜 싫어, 얘야?"
    },
    {
      "idx": 3,
      "speaker": "Max",
      "text": "I don't know anybody.",
      "start_ms": 7651,
      "end_ms": 9703,
      "ko": "아는 애가 아무도 없어요."
    },
    {
      "idx": 4,
      "speaker": "Mom",
      "text": "You'll make new friends.",
      "start_ms": 10303,
      "end_ms": 12179,
      "ko": "새 친구를 사귈 거야."
    },
    {
      "idx": 5,
      "speaker": "Max",
      "text": "What if they don't like me?",
      "start_ms": 12779,
      "end_ms": 14965,
      "ko": "애들이 날 안 좋아하면 어떡해요?"
    },
    {
      "idx": 6,
      "speaker": "Mom",
      "text": "They'll like you.",
      "start_ms": 15565,
      "end_ms": 17019,
      "ko": "다들 널 좋아할 거야."
    },
    {
      "idx": 7,
      "speaker": "Mom",
      "text": "You're a good friend.",
      "start_ms": 17619,
      "end_ms": 19308,
      "ko": "넌 좋은 친구니까."
    },
    {
      "idx": 8,
      "speaker": "Max",
      "text": "Okay.",
      "start_ms": 19908,
      "end_ms": 20885,
      "ko": "알았어요."
    },
    {
      "idx": 9,
      "speaker": "Max",
      "text": "Can you walk me to the door?",
      "start_ms": 21485,
      "end_ms": 23848,
      "ko": "문까지 같이 가 줄 수 있어요?"
    }
  ]
