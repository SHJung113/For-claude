      "ko": "그네예요."
    },
    {
      "idx": 2,
      "speaker": "Mom",
      "text": "Do you want to swing?",
      "start_ms": 3824,
      "end_ms": 5153,
      "ko": "그네 타고 싶니?"
    },
    {
      "idx": 3,
      "speaker": "Max",
      "text": "Yes!",
