    {
      "idx": 0,
      "speaker": "Anchor",
      "text": "Hello again!",
      "start_ms": 250,
      "end_ms": 1898
    },
    {
      "idx": 1,
      "speaker": "Anchor",
      "text": "This is Kids News.",
      "start_ms": 2448,
      "end_ms": 4758
    },
    {
      "idx": 2,
      "speaker": "Anchor",
      "text": "Sea turtles live in the ocean.",
      "start_ms": 5308,
      "end_ms": 8422
    },
    {
      "idx": 3,
      "speaker": "Anchor",
      "text": "But they lay their eggs on the beach.",
      "start_ms": 8972,
      "end_ms": 12259
    },
    {
      "idx": 4,
      "speaker": "Anchor",
      "text": "A mother turtle digs a hole in the sand.",
      "start_ms": 12809,
      "end_ms": 17168
    },
    {
      "idx": 5,
      "speaker": "Anchor",
      "text": "She leaves her eggs there.",
      "start_ms": 17718,
      "end_ms": 20254
    },
    {
      "idx": 6,
      "speaker": "Anchor",
      "text": "When the babies hatch, they crawl to the sea.",
      "start_ms": 20804,
      "end_ms": 25089
    },
    {
      "idx": 7,
      "speaker": "Anchor",
      "text": "Some beaches turn off bright lights at night to help them.",
      "start_ms": 25639,
      "end_ms": 31221
    }
  ]
