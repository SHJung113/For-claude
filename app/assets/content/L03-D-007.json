      "ko": "할아버지가 와 계시거든요."
    },
    {
      "idx": 4,
      "speaker": "Mia",
      "text": "I feel sleepy.",
      "start_ms": 9905,
      "end_ms": 11447,
      "ko": "저는 졸려요."
    },
    {
      "idx": 5,
      "speaker": "Ms. Park",
      "text": "Did you go to bed late?",
      "start_ms": 12147,
      "end_ms": 14347,
      "ko": "늦게 잤어요?"
    },
    {
      "idx": 6,
      "speaker": "Mia",
      "text": "Yes.",
